---
interface Props {
  iataCode: string;
  passengers: string;
  terminals: string;
  distanceToCity: string;
}

const { iataCode, passengers, terminals, distanceToCity } = Astro.props;

const stats = [
  { label: 'IATA code', value: iataCode },
  { label: 'Passengers', value: passengers },
  { label: 'Terminals', value: terminals },
  { label: 'To city center', value: distanceToCity },
];
---

<div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
  {stats.map((s) => (
    <div class="rounded-xl border border-slate-200 bg-white p-4 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-lg font-extrabold text-brand-700 dark:text-brand-300 sm:text-xl">{s.value}</p>
      <p class="mt-1 text-xs uppercase tracking-wide text-slate-400">{s.label}</p>
    </div>
  ))}
</div>
