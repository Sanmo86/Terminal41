---
import { getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // Current pathname (Astro.url.pathname), used to compute the equivalent
  // URL in the other language. Falls back to the homepage of that language
  // if omitted.
  pathname?: string;
  // Full control of the display utility (e.g. "hidden md:inline-flex") —
  // deliberately NOT combined with a hardcoded "inline-flex" base class
  // below, since Tailwind's generated stylesheet order can make a later
  // display utility (inline-flex) win the cascade over an earlier "hidden"
  // on the same element, silently defeating the intended breakpoint.
  class?: string;
}

const { lang, pathname = '/', class: className = 'inline-flex' } = Astro.props;

const enHref = getLocalizedPath(pathname, 'en');
const esHref = getLocalizedPath(pathname, 'es');
---

<div class={`items-center rounded-full border border-slate-200 bg-white p-0.5 text-xs font-semibold dark:border-slate-700 dark:bg-slate-900 ${className}`} role="group" aria-label="Language">
  <a
    href={enHref}
    class={`rounded-full px-2.5 py-1 transition ${lang === 'en' ? 'bg-brand-600 text-white' : 'text-slate-500 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300'}`}
    aria-current={lang === 'en' ? 'true' : undefined}
  >
    EN
  </a>
  <a
    href={esHref}
    class={`rounded-full px-2.5 py-1 transition ${lang === 'es' ? 'bg-brand-600 text-white' : 'text-slate-500 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300'}`}
    aria-current={lang === 'es' ? 'true' : undefined}
  >
    ES
  </a>
</div>
