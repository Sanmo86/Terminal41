---
import { regionLabel } from '../config/site';

interface Props {
  region: string;
  class?: string;
}

const { region, class: className = '' } = Astro.props;
---

<a
  href={`/regions/${region}`}
  class={`inline-flex items-center rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-100 dark:bg-brand-900/40 dark:text-brand-300 dark:hover:bg-brand-900/60 ${className}`}
>
  {regionLabel(region)}
</a>
