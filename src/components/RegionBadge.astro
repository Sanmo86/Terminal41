---
import { regionLabel } from '../config/site';
import type { Lang } from '../i18n/ui';

interface Props {
  region: string;
  lang?: Lang;
  class?: string;
  // Set to false when this badge is nested inside another <a> (e.g. inside
  // ArticleCard's card-wide link) — nested <a> tags are invalid HTML and
  // browsers silently split/duplicate the DOM to recover from it.
  linked?: boolean;
}

const { region, lang = 'en', class: className = '', linked = true } = Astro.props;
const classes = `inline-flex items-center rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-100 dark:bg-brand-900/40 dark:text-brand-300 dark:hover:bg-brand-900/60 ${className}`;
const href = lang === 'es' ? `/es/regions/${region}` : `/regions/${region}`;
---

{linked ? (
  <a href={href} class={classes}>{regionLabel(region, lang)}</a>
) : (
  <span class={classes}>{regionLabel(region, lang)}</span>
)}
