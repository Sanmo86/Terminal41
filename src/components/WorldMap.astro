---
// Interactive world map — complements (does not replace) the homepage
// article grid. Plots every airport with `coordinates` in its frontmatter
// using a simple equirectangular projection onto a 1200x600 canvas, over
// simplified (not geographically precise) continent silhouettes so it
// reads clearly as a world map — see the "Simplified illustrative map"
// caption. Continent outlines are built from hand-plotted coastline
// reference points, then rendered as smooth closed splines (not straight
// polygon edges) via smoothPath() below, for a more natural, hand-drawn
// look. Each marker is a real <a> link — works with zero JS.
import type { CollectionEntry } from 'astro:content';
import { REGIONS, regionLabel } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  entries: CollectionEntry<'airports'>[];
  lang: Lang;
}

const { entries, lang } = Astro.props;
const t = useTranslations(lang);

const REGION_COLORS: Record<string, string> = {
  europe: '#2563eb',
  americas: '#dc2626',
  asia: '#d97706',
  africa: '#16a34a',
  'middle-east': '#9333ea',
  oceania: '#0891b2',
};

const W = 1200;
const H = 600;
function project(lat: number, lng: number) {
  const x = ((lng + 180) / 360) * W;
  const y = ((90 - lat) / 180) * H;
  return { x, y };
}

const markers = entries
  .filter((e) => e.data.coordinates)
  .map((e) => {
    const { x, y } = project(e.data.coordinates!.lat, e.data.coordinates!.lng);
    const href = lang === 'es' ? `/es/airports/${e.data.articleSlug}` : `/airports/${e.data.articleSlug}`;
    return {
      x,
      y,
      href,
      label: `${e.data.iataCode} — ${e.data.city}, ${e.data.country}`,
      color: REGION_COLORS[e.data.region] ?? '#64748b',
    };
  });

// Turns a closed polygon (array of [x,y] points) into a smooth closed
// spline: each edge becomes a quadratic curve through the midpoint of its
// two endpoints, using the shared vertex as the control point. Standard
// "corner rounding" trick for turning hand-plotted reference points into
// an organic, coastline-like outline without needing real map data.
function smoothPath(points: [number, number][]): string {
  const n = points.length;
  const mid = (a: [number, number], b: [number, number]): [number, number] => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
  const start = mid(points[n - 1], points[0]);
  let d = `M ${start[0].toFixed(1)},${start[1].toFixed(1)} `;
  for (let i = 0; i < n; i++) {
    const p = points[i];
    const next = points[(i + 1) % n];
    const m = mid(p, next);
    d += `Q ${p[0].toFixed(1)},${p[1].toFixed(1)} ${m[0].toFixed(1)},${m[1].toFixed(1)} `;
  }
  return d + 'Z';
}

// Continent reference points — same rough real-world coastline landmarks
// as before, now smoothed into curves instead of straight polygon edges.
const CONTINENT_POINTS: [number, number][][] = [
  // North America
  [[80, 63], [133, 100], [183, 137], [200, 187], [233, 223], [293, 250], [333, 273], [333, 217], [283, 203], [330, 193], [353, 163], [380, 150], [417, 137], [393, 110], [317, 100], [267, 67]],
  // South America
  [[343, 273], [483, 317], [457, 377], [410, 417], [373, 483], [357, 433], [343, 340], [337, 297]],
  // Europe
  [[570, 177], [580, 180], [587, 140], [583, 117], [683, 67], [717, 73], [800, 117], [717, 160], [677, 173], [650, 167]],
  // Africa
  [[580, 117], [637, 110], [710, 197], [770, 260], [733, 313], [710, 383], [660, 413], [640, 360], [643, 327], [627, 287], [543, 250]],
  // Asia
  [[717, 177], [750, 233], [833, 233], [857, 273], [917, 233], [950, 283], [983, 317], [1007, 260], [1007, 200], [1023, 177], [1067, 180], [1133, 100], [900, 67], [783, 143]],
  // Australia
  [[1020, 313], [1073, 303], [1110, 390], [1083, 427], [1060, 417], [987, 407], [980, 333]],
];

const CONTINENT_PATHS = CONTINENT_POINTS.map(smoothPath);

// New Zealand — tiny, drawn separately as two small islands near Auckland.
const NEW_ZEALAND = [
  { cx: 1178, cy: 410, rx: 10, ry: 5 },
  { cx: 1185, cy: 425, rx: 9, ry: 6 },
];

const activeRegions = REGIONS.filter((r) => markers.length > 0 && entries.some((e) => e.data.region === r.slug));
---

<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">{t('home.mapTitle')}</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{t('home.mapSubtitle')}</p>
  </div>

  <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full min-w-[640px]" role="img" aria-label={t('home.mapTitle')}>
      <defs>
        <linearGradient id="ocean" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#bae6fd" />
          <stop offset="100%" stop-color="#7dd3fc" />
        </linearGradient>
        <linearGradient id="ocean-dark" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#0c2f52" />
          <stop offset="100%" stop-color="#082238" />
        </linearGradient>
        <linearGradient id="land" x1="0" y1="0" x2="0.3" y2="1">
          <stop offset="0%" stop-color="#bbf7d0" />
          <stop offset="100%" stop-color="#86efac" />
        </linearGradient>
        <linearGradient id="land-dark" x1="0" y1="0" x2="0.3" y2="1">
          <stop offset="0%" stop-color="#14532d" />
          <stop offset="100%" stop-color="#0f3d22" />
        </linearGradient>
      </defs>

      <rect width={W} height={H} class="fill-[url(#ocean)] dark:fill-[url(#ocean-dark)]" />

      {CONTINENT_PATHS.map((d) => (
        <path
          d={d}
          class="fill-[url(#land)] stroke-emerald-600 dark:fill-[url(#land-dark)] dark:stroke-emerald-800"
          stroke-width="2"
          stroke-linejoin="round"
        />
      ))}
      {NEW_ZEALAND.map((nz) => (
        <ellipse
          cx={nz.cx}
          cy={nz.cy}
          rx={nz.rx}
          ry={nz.ry}
          class="fill-[url(#land)] stroke-emerald-600 dark:fill-[url(#land-dark)] dark:stroke-emerald-800"
          stroke-width="2"
        />
      ))}

      {markers.map((m) => (
        <a href={m.href}>
          <title>{m.label}</title>
          <circle cx={m.x} cy={m.y} r="13" fill="transparent" />
          <circle cx={m.x} cy={m.y} r="6" fill={m.color} stroke="#ffffff" stroke-width="2" class="transition-transform hover:scale-150" style="transform-origin: center; transform-box: fill-box;" />
        </a>
      ))}
    </svg>
  </div>
  <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
    {lang === 'es'
      ? 'Mapa esquemático simplificado, no a escala exacta.'
      : 'Simplified schematic map, not to exact scale.'}
  </p>

  {activeRegions.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
      {activeRegions.map((r) => (
        <span class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
          <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background-color: ${REGION_COLORS[r.slug] ?? '#64748b'}`} />
          {regionLabel(r.slug, lang)}
        </span>
      ))}
    </div>
  )}
</section>
