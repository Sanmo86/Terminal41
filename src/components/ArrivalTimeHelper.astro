---
// Small interactive widget: pick your flight type, see the recommended
// arrival time and typical/peak security wait instantly. Pure vanilla JS,
// no framework — supports multiple instances on a page via closest().
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  typeALabel: string;
  typeATypical: string;
  typeAPeak: string;
  typeAArrival: string;
  typeBLabel: string;
  typeBTypical: string;
  typeBPeak: string;
  typeBArrival: string;
  lang: Lang;
}

const {
  typeALabel,
  typeATypical,
  typeAPeak,
  typeAArrival,
  typeBLabel,
  typeBTypical,
  typeBPeak,
  typeBArrival,
  lang,
} = Astro.props;
const t = useTranslations(lang);
---

<div class="arrival-helper not-prose my-8 rounded-2xl border border-brand-200 bg-brand-50/60 p-5 dark:border-brand-900 dark:bg-brand-950/30">
  <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('arrival.question')}</p>
  <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={t('arrival.question')}>
    <button
      type="button"
      class="option-btn rounded-full border border-brand-300 bg-white px-4 py-1.5 text-sm font-semibold text-brand-700 shadow-sm transition hover:bg-brand-50 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-brand-700 dark:bg-slate-900 dark:text-brand-300"
      data-target="a"
      aria-pressed="true"
    >
      {typeALabel}
    </button>
    <button
      type="button"
      class="option-btn rounded-full border border-brand-300 bg-white px-4 py-1.5 text-sm font-semibold text-brand-700 shadow-sm transition hover:bg-brand-50 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-brand-700 dark:bg-slate-900 dark:text-brand-300"
      data-target="b"
      aria-pressed="false"
    >
      {typeBLabel}
    </button>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    <div class="rounded-lg bg-white p-3 dark:bg-slate-900">
      <p class="text-xs uppercase tracking-wide text-slate-400">{t('arrival.arriveAt')}</p>
      <p class="result-arrival mt-1 text-lg font-bold text-slate-800 dark:text-slate-100" data-a={typeAArrival} data-b={typeBArrival}>
        {typeAArrival}
      </p>
    </div>
    <div class="rounded-lg bg-white p-3 dark:bg-slate-900">
      <p class="text-xs uppercase tracking-wide text-slate-400">{t('arrival.typicalWait')}</p>
      <p class="result-typical mt-1 text-lg font-bold text-slate-800 dark:text-slate-100" data-a={typeATypical} data-b={typeBTypical}>
        {typeATypical}
      </p>
    </div>
    <div class="rounded-lg bg-white p-3 dark:bg-slate-900">
      <p class="text-xs uppercase tracking-wide text-slate-400">{t('arrival.peakWait')}</p>
      <p class="result-peak mt-1 text-lg font-bold text-slate-800 dark:text-slate-100" data-a={typeAPeak} data-b={typeBPeak}>
        {typeAPeak}
      </p>
    </div>
  </div>
</div>

<script>
  function initArrivalHelpers() {
    document.querySelectorAll<HTMLElement>('.arrival-helper').forEach((widget) => {
      if (widget.dataset.initialized === 'true') return;
      widget.dataset.initialized = 'true';

      const buttons = widget.querySelectorAll<HTMLButtonElement>('.option-btn');
      const arrivalEl = widget.querySelector<HTMLElement>('.result-arrival');
      const typicalEl = widget.querySelector<HTMLElement>('.result-typical');
      const peakEl = widget.querySelector<HTMLElement>('.result-peak');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.target; // "a" | "b"
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          if (!target) return;
          if (arrivalEl) arrivalEl.textContent = arrivalEl.dataset[target] ?? '';
          if (typicalEl) typicalEl.textContent = typicalEl.dataset[target] ?? '';
          if (peakEl) peakEl.textContent = peakEl.dataset[target] ?? '';
        });
      });
    });
  }

  initArrivalHelpers();
  document.addEventListener('astro:page-load', initArrivalHelpers);
</script>
