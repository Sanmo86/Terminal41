---
import { useTranslations, type Lang } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
// Only show h2/h3 — h1 is the article title itself, deeper levels get noisy.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav aria-label={t('toc.title')} class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm dark:border-slate-800 dark:bg-slate-900">
    <p class="mb-2 font-semibold text-slate-700 dark:text-slate-200">{t('toc.title')}</p>
    <ul class="space-y-1.5">
      {items.map((h) => (
        <li class={h.depth === 3 ? 'ml-3' : ''}>
          <a href={`#${h.slug}`} class="text-slate-500 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300">
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
