---
// Cookie consent banner. Dispatches 'terminal41:consent-accepted' on Accept
// so Analytics.astro (Google Analytics) can start loading immediately,
// without waiting for a page reload. Nothing analytics-related loads until
// this fires (or `terminal41HasAnalyticsConsent()` already returns true
// from a previous visit).
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cookiePolicyHref = lang === 'es' ? '/es/cookie-policy' : '/cookie-policy';
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-slate-200 bg-white/95 p-4 backdrop-blur sm:p-5 dark:border-slate-800 dark:bg-slate-950/95"
  role="dialog"
  aria-label="Cookie notice"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-600 dark:text-slate-300">
      {t('cookie.message')}
      <a href={cookiePolicyHref} class="underline hover:text-brand-700 dark:hover:text-brand-300">{t('cookie.policyLink')}</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        id="cookie-decline"
        class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-900"
      >
        {t('cookie.decline')}
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="rounded-full bg-brand-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-brand-700"
      >
        {t('cookie.accept')}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  // is:inline is load-bearing here, not just style: Analytics.astro's
  // script is also is:inline and calls window.terminal41HasAnalyticsConsent()
  // synchronously as soon as it runs. Without is:inline, Astro compiles
  // this script as type="module", which the HTML spec defers until after
  // the document finishes parsing — so Analytics' immediate check would
  // always run first and find the function undefined, silently skipping
  // GA for every returning visitor (anyone who isn't clicking "Accept"
  // in that exact pageview). Keeping both scripts inline preserves plain
  // top-to-bottom execution order, which is what both actually depend on.
  const STORAGE_KEY = 'terminal41-cookie-consent';

  // Exposed globally so a future analytics snippet can check this before
  // loading, e.g.: `if (window.terminal41HasAnalyticsConsent()) { ...load GA... }`
  window.terminal41HasAnalyticsConsent = function () {
    return localStorage.getItem(STORAGE_KEY) === 'accepted';
  };

  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;

    const existing = localStorage.getItem(STORAGE_KEY);
    if (!existing) {
      banner.classList.remove('hidden');
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      banner.classList.add('hidden');
      window.dispatchEvent(new Event('terminal41:consent-accepted'));
    });

    document.getElementById('cookie-decline')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'declined');
      banner.classList.add('hidden');
    });
  }

  initCookieBanner();
  document.addEventListener('astro:page-load', initCookieBanner);
</script>
