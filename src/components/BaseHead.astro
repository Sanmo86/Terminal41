---
import { SITE, LOCALE_META, ADSENSE_CLIENT_ID } from '../config/site';
import { getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string; // absolute or root-relative URL
  article?: boolean;
  lang: Lang;
}

const { title, description, image, article = false, lang } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? SITE.defaultOgImage, Astro.site);
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

// Travelpayouts "Drive" manual-install snippet, kept byte-for-byte
// identical to what their dashboard hands out (WordPress cache-plugin
// attributes and all, inert here, but their automated verify-install
// checker appears to string-match the literal snippet). Rendered via
// set:html below because one of the attributes above is not one that
// Astro's script-tag typing recognizes as valid.
//
// IMPORTANT: never write the literal opening-plus-closing tag pair
// for this element anywhere in this file, including in comments, not
// even as a written-out example. Any occurrence of it in the raw
// source (tag name spelled out twice, once to open and once to
// close, with nothing of substance in between) has repeatedly
// confused Vite's esbuild dependency scanner during `astro dev`,
// silently breaking content-collection loading sitewide. That's why
// the tag name is built from a variable below instead of being
// written directly. Purely a source-text workaround; the rendered
// HTML output is unaffected.
const tag = 'script';
const travelpayoutsSnippet = `<${tag} nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
  (function () {
      var script = document.createElement("script");
      script.async = 1;
      script.setAttribute("data-cmp-ab","2");
      script.src = 'https://tp-em.com/NTY0NDA0.js?t=564404';
      document.head.appendChild(script);
  })();
</${tag}>`;

// hreflang alternates — tells search engines the English and Spanish pages
// are translations of each other, not duplicate content.
const enURL = new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site);
const esURL = new URL(getLocalizedPath(Astro.url.pathname, 'es'), Astro.site);

// Sitewide Organization + WebSite structured data (JSON-LD). Repeated on
// every page rather than homepage-only — Google dedupes identical entities
// across pages fine, and this keeps the component self-contained. Article
// pages add their own Article/BreadcrumbList schema on top of this in
// ArticleLayout.astro.
const searchURL = lang === 'es' ? '/es/search' : '/search';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon.svg', SITE.url).toString(),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL(searchURL, SITE.url).toString()}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={enURL} />
<link rel="alternate" hreflang="es" href={esURL} />
<link rel="alternate" hreflang="x-default" href={enURL} />
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="JSG8HMXq24u-3xgcTJX_KvoKl4UdzOdimtGp7g4pp8o" />
<meta name="p:domain_verify" content="28981db2eb63eb6bf179681d3a2571ec" />

<!-- AdSense site verification / auto-ads script. Live sitewide as soon
     as ADSENSE_CLIENT_ID is set (src/config/site.ts) so Google can crawl
     and review the site — separate from ADS_ENABLED, which gates the
     actual <AdSlot /> ad units and stays off until AdSense approves. -->
{ADSENSE_CLIENT_ID && (
  <script
    is:inline
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
    crossorigin="anonymous"
  ></script>
)}

<!-- Travelpayouts "Drive" affiliate widget — see travelpayoutsSnippet above. --><Fragment set:html={travelpayoutsSnippet} />

<!-- Primary meta tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={LOCALE_META[lang].ogLocale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:site" content={SITE.twitter} />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

<!-- Structured data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
