---
// "Book & Save" box — renders only the links that are actually configured,
// preferring a per-article override (entry.data.affiliateLinks) and falling
// back to the sitewide defaults in src/config/site.ts (AFFILIATE_LINKS).
// Mirrors the AdSlot.astro pattern: the whole block is scaffolding-only and
// renders nothing until real URLs are filled in — no placeholder/fake links
// are ever shown to visitors.
import { AFFILIATE_LINKS } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Links {
  parking?: string;
  lounge?: string;
  esim?: string;
  carRental?: string;
  flights?: string;
  hotels?: string;
  activities?: string;
}

interface Props {
  links?: Links;
  lang: Lang;
}

const { links, lang } = Astro.props;
const t = useTranslations(lang);

const resolved = {
  flights: links?.flights || AFFILIATE_LINKS.flights,
  hotels: links?.hotels || AFFILIATE_LINKS.hotels,
  activities: links?.activities || AFFILIATE_LINKS.activities,
  carRental: links?.carRental || AFFILIATE_LINKS.carRental,
  lounge: links?.lounge || AFFILIATE_LINKS.lounge,
  parking: links?.parking || AFFILIATE_LINKS.parking,
  esim: links?.esim || AFFILIATE_LINKS.esim,
};

const items = [
  { key: 'flights', href: resolved.flights, label: t('affiliate.flights'), icon: 'M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z' },
  { key: 'hotels', href: resolved.hotels, label: t('affiliate.hotels'), icon: 'M3 19v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 19h18M3 19v2M21 19v2M7 10V7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3' },
  { key: 'activities', href: resolved.activities, label: t('affiliate.activities'), icon: 'M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V8ZM10 6v1M10 17v1M10 11v2' },
  { key: 'carRental', href: resolved.carRental, label: t('affiliate.carRental'), icon: 'M5 17h14M6 17l1.5-5h9L18 17M8 17v2M16 17v2M6 12h12' },
  { key: 'lounge', href: resolved.lounge, label: t('affiliate.lounge'), icon: 'M4 19h16M6 19V9h5v10M13 19v-6h5v6' },
  { key: 'parking', href: resolved.parking, label: t('affiliate.parking'), icon: 'M9 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM19 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM3 17V7a1 1 0 0 1 1-1h9l5 5v6M3 12h13' },
  { key: 'esim', href: resolved.esim, label: t('affiliate.esim'), icon: 'M7 4h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1ZM10 18h4' },
].filter((item): item is typeof item & { href: string } => !!item.href);
---

{items.length > 0 && (
  <div class="not-prose my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
    <p class="text-sm font-bold text-slate-800 dark:text-slate-100">{t('affiliate.title')}</p>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      {items.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener sponsored nofollow"
          class="flex items-center gap-2.5 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:border-brand-300 hover:text-brand-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:text-brand-300"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-brand-600 dark:text-brand-400" aria-hidden="true">
            <path d={item.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {item.label}
        </a>
      ))}
    </div>
    <p class="mt-3 text-xs text-slate-400 dark:text-slate-500">{t('affiliate.disclosure')}</p>
  </div>
)}
