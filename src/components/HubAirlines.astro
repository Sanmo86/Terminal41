---
// Simple pill/badge row for hub/anchor airlines — a lighter-weight visual
// than a full paragraph, and gives the top of the article another glance-
// able element alongside QuickFacts.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  airlines: string[];
  lang: Lang;
}

const { airlines, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="not-prose mb-8 flex flex-wrap items-center gap-2">
  <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t('hubAirlines.title')}:</span>
  {airlines.map((airline) => (
    <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
      {airline}
    </span>
  ))}
</div>
