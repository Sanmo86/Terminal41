---
import { SITE, REGIONS, regionLabel } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'es' ? '/es' : '';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <p class="text-lg font-bold text-brand-800 dark:text-brand-300">{SITE.name}</p>
        <p class="mt-2 max-w-xs text-sm text-slate-500 dark:text-slate-400">{t('home.tagline')}</p>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('footer.regions')}</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-500 dark:text-slate-400">
          {REGIONS.map((r) => (
            <li><a href={`${prefix}/regions/${r.slug}`} class="hover:text-brand-700 dark:hover:text-brand-300">{regionLabel(r.slug, lang)}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('footer.site')}</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-500 dark:text-slate-400">
          <li><a href={`${prefix}/about`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('footer.about')}</a></li>
          <li><a href={`${prefix}/search`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('footer.search')}</a></li>
          <li><a href={`${prefix}/rankings`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.rankings')}</a></li>
          <li><a href={`${prefix}/directory`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.directory')}</a></li>
          <li><a href="/rss.xml" class="hover:text-brand-700 dark:hover:text-brand-300">{t('footer.rss')}</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('footer.legal')}</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-500 dark:text-slate-400">
          <li><a href={`${prefix}/legal-notice`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('footer.legalNotice')}</a></li>
          <li><a href={`${prefix}/privacy-policy`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('footer.privacyPolicy')}</a></li>
          <li><a href={`${prefix}/cookie-policy`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('footer.cookiePolicy')}</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-8 text-xs text-slate-400 dark:text-slate-500">© {year} {SITE.name}. {t('footer.rights')}</p>
  </div>
</footer>
