---
import { SITE, REGIONS } from '../config/site';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight text-brand-800 dark:text-brand-300">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M2.5 19.5L21.5 12L2.5 4.5L2.5 10.5L16.5 12L2.5 13.5L2.5 19.5Z" fill="currentColor" />
      </svg>
      <span>{SITE.name}</span>
    </a>

    <nav class="hidden flex-1 items-center gap-5 text-sm font-medium text-slate-600 md:flex dark:text-slate-300">
      <a href="/" class="hover:text-brand-700 dark:hover:text-brand-300">Home</a>
      <div class="group relative">
        <button type="button" class="flex items-center gap-1 hover:text-brand-700 dark:hover:text-brand-300">
          Regions
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 w-48 rounded-lg border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 dark:border-slate-800 dark:bg-slate-900">
          {REGIONS.map((r) => (
            <a href={`/regions/${r.slug}`} class="block px-4 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800">{r.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <form action="/search" method="get" class="ml-auto flex w-full max-w-xs items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm focus-within:ring-2 focus-within:ring-brand-400 dark:border-slate-800 dark:bg-slate-900">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0 text-slate-400" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Search airport or city…"
        class="w-full bg-transparent text-slate-700 outline-none placeholder:text-slate-400 dark:text-slate-200"
        aria-label="Search airports"
      />
    </form>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="flex shrink-0 items-center justify-center rounded-lg border border-slate-200 p-2 text-slate-600 md:hidden dark:border-slate-800 dark:text-slate-300"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 md:hidden dark:border-slate-800 dark:text-slate-300">
    <a href="/" class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">Home</a>
    <p class="mt-2 px-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Regions</p>
    {REGIONS.map((r) => (
      <a href={`/regions/${r.slug}`} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{r.label}</a>
    ))}
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.initialized === 'true') return;
    toggle.dataset.initialized = 'true';

    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
