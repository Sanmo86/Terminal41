---
import { SITE, REGIONS, regionLabel } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  pathname?: string;
}

const { lang, pathname = '/' } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'es' ? '/es' : '';
const homeHref = lang === 'es' ? '/es/' : '/';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href={homeHref} class="flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight text-brand-800 dark:text-brand-300">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M2.5 19.5L21.5 12L2.5 4.5L2.5 10.5L16.5 12L2.5 13.5L2.5 19.5Z" fill="currentColor" />
      </svg>
      <span>{SITE.name}</span>
    </a>

    <nav class="hidden flex-1 items-center gap-5 text-sm font-medium text-slate-600 md:flex dark:text-slate-300">
      <a href={homeHref} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.home')}</a>
      <div class="group relative">
        <button type="button" class="flex items-center gap-1 hover:text-brand-700 dark:hover:text-brand-300">
          {t('nav.regions')}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 w-48 rounded-lg border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 dark:border-slate-800 dark:bg-slate-900">
          {REGIONS.map((r) => (
            <a href={`${prefix}/regions/${r.slug}`} class="block px-4 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800">{regionLabel(r.slug, lang)}</a>
          ))}
        </div>
      </div>
      <a href={`${prefix}/about`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.about')}</a>
      <a href={`${prefix}/trivia`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.trivia')}</a>
      <a href={`${prefix}/compare`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.compare')}</a>
      <a href={`${prefix}/rankings`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.rankings')}</a>
      <a href={`${prefix}/directory`} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.directory')}</a>
    </nav>

    <button
      type="button"
      id="surprise-me-btn"
      data-index-url={`${prefix}/search-index.json`}
      data-article-base={`${prefix}/airports`}
      class="hidden shrink-0 items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-brand-300 hover:text-brand-700 md:inline-flex dark:border-slate-800 dark:text-slate-300 dark:hover:text-brand-300"
      title={t('nav.surpriseMe')}
    >
      🎲 {t('nav.surpriseMe')}
    </button>

    <LanguageSwitcher lang={lang} pathname={pathname} class="hidden md:inline-flex" />

    <form action={`${prefix}/search`} method="get" class="ml-auto flex w-full max-w-xs items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm focus-within:ring-2 focus-within:ring-brand-400 dark:border-slate-800 dark:bg-slate-900">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0 text-slate-400" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        name="q"
        placeholder={t('nav.searchPlaceholder')}
        class="w-full bg-transparent text-slate-700 outline-none placeholder:text-slate-400 dark:text-slate-200"
        aria-label={t('nav.searchLabel')}
      />
    </form>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="flex shrink-0 items-center justify-center rounded-lg border border-slate-200 p-2 text-slate-600 md:hidden dark:border-slate-800 dark:text-slate-300"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t('nav.toggleMenu')}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 md:hidden dark:border-slate-800 dark:text-slate-300">
    <a href={homeHref} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{t('nav.home')}</a>
    <p class="mt-2 px-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{t('nav.regions')}</p>
    {REGIONS.map((r) => (
      <a href={`${prefix}/regions/${r.slug}`} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{regionLabel(r.slug, lang)}</a>
    ))}
    <a href={`${prefix}/about`} class="mt-2 block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{t('nav.about')}</a>
    <a href={`${prefix}/trivia`} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{t('nav.trivia')}</a>
    <a href={`${prefix}/compare`} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{t('nav.compare')}</a>
    <a href={`${prefix}/rankings`} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{t('nav.rankings')}</a>
    <a href={`${prefix}/directory`} class="block rounded-lg px-2 py-2 hover:bg-slate-50 dark:hover:bg-slate-900">{t('nav.directory')}</a>
    <button
      type="button"
      id="surprise-me-btn-mobile"
      data-index-url={`${prefix}/search-index.json`}
      data-article-base={`${prefix}/airports`}
      class="block w-full rounded-lg px-2 py-2 text-left hover:bg-slate-50 dark:hover:bg-slate-900"
    >
      🎲 {t('nav.surpriseMe')}
    </button>
    <div class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-800">
      <LanguageSwitcher lang={lang} pathname={pathname} />
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.initialized === 'true') return;
    toggle.dataset.initialized = 'true';

    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  async function goToRandomAirport(button: HTMLButtonElement) {
    if (!button || button.dataset.loading === 'true') return;
    button.dataset.loading = 'true';
    try {
      const indexUrl = button.dataset.indexUrl;
      const articleBase = button.dataset.articleBase;
      if (!indexUrl || !articleBase) return;
      const res = await fetch(indexUrl);
      const items = await res.json();
      if (!Array.isArray(items) || items.length === 0) return;
      const currentSlug = window.location.pathname.split('/').filter(Boolean).pop();
      const pool = items.length > 1 ? items.filter((i: { slug: string }) => i.slug !== currentSlug) : items;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      window.location.href = `${articleBase}/${pick.slug}`;
    } finally {
      button.dataset.loading = 'false';
    }
  }

  function initSurpriseMe() {
    document.querySelectorAll<HTMLButtonElement>('#surprise-me-btn, #surprise-me-btn-mobile').forEach((btn) => {
      if (btn.dataset.initialized === 'true') return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => goToRandomAirport(btn));
    });
  }

  initMobileMenu();
  initSurpriseMe();
  document.addEventListener('astro:page-load', initMobileMenu);
  document.addEventListener('astro:page-load', initSurpriseMe);
</script>
