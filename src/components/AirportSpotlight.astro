---
// A highlighted callout for one genuinely airport-specific fact or tip —
// deliberately NOT generic travel advice (that lives in the prose body).
// Gives every article a distinct visual moment early on.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  text: string;
  lang: Lang;
}

const { title, text, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="not-prose my-8 overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-orange-50 p-5 dark:border-amber-900 dark:from-amber-950/30 dark:to-orange-950/20">
  <div class="flex items-start gap-3">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-500 text-white">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2l2.4 6.5L21 11l-6.6 2.5L12 20l-2.4-6.5L3 11l6.6-2.5L12 2z" fill="currentColor" />
      </svg>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-amber-700 dark:text-amber-400">{t('spotlight.eyebrow')}</p>
      <p class="mt-1 font-bold text-slate-800 dark:text-slate-100">{title}</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{text}</p>
    </div>
  </div>
</div>
