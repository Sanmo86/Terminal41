---
// Responsive HTML replacement for the old static amenities-icon SVG —
// same mobile-legibility fix as TransportOptions.
interface Item {
  key: 'wifi' | 'lounges' | 'duty-free' | 'dining';
  label: string;
  detail: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

// Keyed by the stable `key` field (not the translated `label`) so icons
// resolve correctly regardless of locale.
const icons: Record<Item['key'], string> = {
  wifi: 'M6.5 12.5a8 8 0 0 1 11 0M9 15.5a4 4 0 0 1 6 0M12 18.5h.01',
  lounges: 'M4 19h16M6 19V9h5v10M13 19v-6h5v6',
  'duty-free': 'M6 8h12l-1 11H7L6 8ZM9 8V6a3 3 0 0 1 6 0v2',
  dining: 'M7 3v7M5 3v7M9 3v7M7 10v11M16 3c-2 0-3 2-3 5v3h2v10',
};
---

<div class="not-prose my-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
  {items.map((item) => (
    <div class="rounded-xl border border-slate-200 bg-white p-4 text-center dark:border-slate-800 dark:bg-slate-900">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" class="mx-auto text-brand-600 dark:text-brand-400" aria-hidden="true">
        <path d={icons[item.key] ?? icons.wifi} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p class="mt-2 text-sm font-bold text-slate-800 dark:text-slate-100">{item.label}</p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{item.detail}</p>
    </div>
  ))}
</div>
