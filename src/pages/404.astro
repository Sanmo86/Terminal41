---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist." lang="en">
  <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold text-brand-600">404</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">
      Looks like this flight doesn't exist
    </h1>
    <p class="mt-3 text-slate-500 dark:text-slate-400">
      The page you're looking for has been rerouted or never took off.
    </p>
    <a href="/" class="mt-6 inline-block rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">
      Back to home
    </a>
  </section>
</BaseLayout>
