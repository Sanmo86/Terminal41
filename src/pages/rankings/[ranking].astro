---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegionBadge from '../../components/RegionBadge.astro';
import { RANKINGS } from '../../lib/airportMetrics';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

export async function getStaticPaths() {
  return RANKINGS.map((r) => ({ params: { ranking: r.slug } }));
}

const { ranking: rankingSlug } = Astro.params;
const ranking = RANKINGS.find((r) => r.slug === rankingSlug)!;

const entries = await getCollection('airports', ({ data }) => !data.draft && data.lang === lang);

const ranked = entries
  .map((entry) => {
    const metric = ranking.getMetric(entry.data);
    return metric ? { entry, metric } : null;
  })
  .filter((x): x is { entry: (typeof entries)[number]; metric: NonNullable<ReturnType<typeof ranking.getMetric>> } => x !== null)
  .sort((a, b) => {
    const diff = ranking.sortDirection === 'asc' ? a.metric.value - b.metric.value : b.metric.value - a.metric.value;
    return diff !== 0 ? diff : a.entry.data.city.localeCompare(b.entry.data.city);
  });
---

<BaseLayout title={`${ranking.label[lang]} | ${t('rankings.title')}`} description={ranking.description[lang]} lang={lang}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="mb-2 text-sm text-slate-500 dark:text-slate-400">
      <a href="/rankings" class="hover:text-brand-700 dark:hover:text-brand-300">{t('rankings.crumb')}</a>
      <span class="mx-1">/</span>
      <span>{ranking.label[lang]}</span>
    </nav>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
      <span class="mr-2">{ranking.icon}</span>{ranking.label[lang]}
    </h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">{ranking.description[lang]}</p>
    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-400">{ranked.length} {t('rankings.countSuffix')}</p>

    <ol class="mt-6 space-y-3">
      {ranked.map(({ entry, metric }, i) => (
        <li>
          <a
            href={`/airports/${entry.data.articleSlug}`}
            class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-3 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:p-4 dark:border-slate-800 dark:bg-slate-900"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-bold text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">
              {i + 1}
            </span>
            <img src={entry.data.image} alt={entry.data.imageAlt} width="80" height="42" class="hidden h-11 w-20 shrink-0 rounded object-cover sm:block" />
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-bold text-slate-900 dark:text-slate-100">{entry.data.iataCode} — {entry.data.city}</span>
                <RegionBadge region={entry.data.region} lang={lang} linked={false} />
              </div>
              <p class="truncate text-sm text-slate-500 dark:text-slate-400">{entry.data.airport}</p>
            </div>
            <span class="shrink-0 text-right text-sm font-semibold text-brand-700 dark:text-brand-300">{metric.display}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
