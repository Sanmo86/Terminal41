---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'es';
const t = useTranslations(lang);
const indexUrl = '/es/search-index.json';
const articleBase = '/es/airports';
---

<BaseLayout title={t('iata.title')} description={t('iata.subtitle')} lang={lang}>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">{t('iata.title')}</h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">{t('iata.subtitle')}</p>

    <div class="mt-6 flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2.5 shadow-sm focus-within:ring-2 focus-within:ring-brand-400 dark:border-slate-800 dark:bg-slate-900">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-slate-400" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        id="iata-search"
        type="search"
        placeholder={t('iata.placeholder')}
        class="w-full bg-transparent text-slate-700 outline-none placeholder:text-slate-400 dark:text-slate-200"
      />
    </div>

    <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
      <table class="w-full min-w-[520px] border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-900">
            <th class="p-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-400">{t('iata.colCode')}</th>
            <th class="p-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-400">{t('iata.colAirport')}</th>
            <th class="p-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-400">{t('iata.colLocation')}</th>
            <th class="p-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-400"></th>
          </tr>
        </thead>
        <tbody id="iata-rows"></tbody>
      </table>
    </div>
    <p id="iata-empty" class="mt-6 hidden text-center text-slate-400 dark:text-slate-500">{t('iata.noResults')}</p>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{
    indexUrl,
    articleBase,
    i18n: { readGuide: t('iata.readGuide') },
  }}
>
  function initIataLookup() {
    const input = document.getElementById('iata-search');
    const rowsEl = document.getElementById('iata-rows');
    const emptyEl = document.getElementById('iata-empty');
    if (!input || input.dataset.initialized === 'true') return;
    input.dataset.initialized = 'true';

    let items = [];

    function render(filtered) {
      const sorted = [...filtered].sort((a, b) => a.city.localeCompare(b.city));
      rowsEl.innerHTML = sorted
        .map(
          (item) => `
        <tr class="border-t border-slate-100 dark:border-slate-800">
          <td class="p-3 font-mono text-base font-extrabold text-brand-700 dark:text-brand-300">${item.iataCode}</td>
          <td class="p-3 text-slate-800 dark:text-slate-100">${item.airport}</td>
          <td class="p-3 text-slate-500 dark:text-slate-400">${item.city}, ${item.country}</td>
          <td class="p-3 text-right"><a href="${articleBase}/${item.slug}" class="font-semibold text-brand-700 hover:underline dark:text-brand-300">${i18n.readGuide}</a></td>
        </tr>`
        )
        .join('');
      emptyEl.classList.toggle('hidden', sorted.length !== 0);
    }

    function filter(query) {
      const q = query.trim().toLowerCase();
      if (!q) return render(items);
      render(
        items.filter((item) =>
          [item.title, item.airport, item.city, item.country, item.iataCode].join(' ').toLowerCase().includes(q)
        )
      );
    }

    async function init() {
      const res = await fetch(indexUrl);
      items = await res.json();
      render(items);
      input.addEventListener('input', () => filter(input.value));
    }

    init();
  }

  initIataLookup();
  document.addEventListener('astro:page-load', initIataLookup);
</script>
