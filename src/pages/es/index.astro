---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import WorldMap from '../../components/WorldMap.astro';
import { SITE, REGIONS, regionLabel } from '../../config/site';
import { useTranslations } from '../../i18n/ui';

const lang = 'es';
const t = useTranslations(lang);

const entries = (await getCollection('airports', ({ data }) => !data.draft && data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const activeRegions = REGIONS.filter((r) => entries.some((e) => e.data.region === r.slug));
---

<BaseLayout title={SITE.name} description={t('home.description')} lang={lang}>
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white dark:border-slate-800 dark:from-slate-900 dark:to-slate-950">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
        {t('home.tagline')}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
        {t('home.description')}
      </p>
    </div>
  </section>

  <WorldMap entries={entries} lang={lang} />

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <AdSlot placement="home-top" />

    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">{t('home.latestGuides')}</h2>
      <span id="result-count" class="text-sm text-slate-400">{entries.length} {entries.length === 1 ? t('home.airport') : t('home.airports')}</span>
    </div>

    {activeRegions.length > 1 && (
      <div id="region-filters" class="mb-6 flex flex-wrap gap-2" role="group" aria-label={t('footer.regions')}>
        <button type="button" class="filter-chip is-active rounded-full border border-brand-300 bg-brand-600 px-3.5 py-1.5 text-sm font-semibold text-white shadow-sm" data-region="all">
          {t('home.allRegions')}
        </button>
        {activeRegions.map((r) => (
          <button type="button" class="filter-chip rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm font-semibold text-slate-600 shadow-sm transition hover:border-brand-300 hover:text-brand-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300" data-region={r.slug}>
            {regionLabel(r.slug, lang)}
          </button>
        ))}
      </div>
    )}

    {entries.length === 0 ? (
      <p class="text-slate-500 dark:text-slate-400">{t('home.noArticles')}</p>
    ) : (
      <div id="article-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => <ArticleCard entry={entry} lang={lang} />)}
      </div>
    )}
    <p id="no-results" class="hidden text-slate-500 dark:text-slate-400">{t('home.noRegionResults')}</p>
  </section>
</BaseLayout>

<script is:inline define:vars={{ airportLabel: t('home.airport'), airportsLabel: t('home.airports') }}>
  function initRegionFilters() {
    const filterBar = document.getElementById('region-filters');
    const grid = document.getElementById('article-grid');
    const countEl = document.getElementById('result-count');
    const noResultsEl = document.getElementById('no-results');
    if (!filterBar || !grid) return;

    const chips = filterBar.querySelectorAll('.filter-chip');
    const cards = grid.querySelectorAll('[data-region]');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const region = chip.dataset.region ?? 'all';

        chips.forEach((c) => {
          const active = c === chip;
          c.classList.toggle('is-active', active);
          c.classList.toggle('bg-brand-600', active);
          c.classList.toggle('text-white', active);
          c.classList.toggle('border-brand-300', active);
          c.classList.toggle('bg-white', !active);
          c.classList.toggle('dark:bg-slate-900', !active);
          c.classList.toggle('text-slate-600', !active);
          c.classList.toggle('dark:text-slate-300', !active);
        });

        let visible = 0;
        cards.forEach((card) => {
          const match = region === 'all' || card.dataset.region === region;
          card.classList.toggle('hidden', !match);
          if (match) visible++;
        });

        if (countEl) countEl.textContent = `${visible} ${visible === 1 ? airportLabel : airportsLabel}`;
        if (noResultsEl) noResultsEl.classList.toggle('hidden', visible !== 0);
      });
    });
  }

  initRegionFilters();
  document.addEventListener('astro:page-load', initRegionFilters);
</script>
