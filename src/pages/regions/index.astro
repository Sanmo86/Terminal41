---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REGIONS, SITE } from '../../config/site';

const entries = await getCollection('airports', ({ data }) => !data.draft);
const counts = Object.fromEntries(
  REGIONS.map((r) => [r.slug, entries.filter((e) => e.data.region === r.slug).length])
);
---

<BaseLayout title="Regions" description={`Browse ${SITE.name} airport guides by region.`}>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">Browse by region</h1>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {REGIONS.map((r) => (
        <a
          href={`/regions/${r.slug}`}
          class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
        >
          <span class="font-semibold text-slate-800 dark:text-slate-100">{r.label}</span>
          <span class="text-sm text-slate-400">{counts[r.slug]} airport{counts[r.slug] === 1 ? '' : 's'}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
