---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import RegionBadge from '../components/RegionBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AdSlot from '../components/AdSlot.astro';
import QuickFacts from '../components/QuickFacts.astro';
import ArrivalTimeHelper from '../components/ArrivalTimeHelper.astro';
import TransportOptions from '../components/TransportOptions.astro';
import AmenityGrid from '../components/AmenityGrid.astro';
import AirportSpotlight from '../components/AirportSpotlight.astro';
import HubAirlines from '../components/HubAirlines.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'airports'>;
  headings: Heading[];
  lang: Lang;
}

const { entry, headings, lang } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  airport,
  iataCode,
  city,
  country,
  date,
  updatedDate,
  image,
  imageAlt,
  excerpt,
  region,
  tags,
  seoTitle,
  seoDescription,
  quickFacts,
  security,
  arrivalGuidance,
  transportOptions,
  amenities,
  spotlight,
  hubAirlines,
} = entry.data;

const homeHref = lang === 'es' ? '/es/' : '/';
const dateLocale = lang === 'es' ? 'es-ES' : 'en-US';
const dateOpts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const formattedDate = date.toLocaleDateString(dateLocale, dateOpts);
const formattedUpdated = updatedDate?.toLocaleDateString(dateLocale, dateOpts);
---

<BaseLayout title={seoTitle ?? title} description={seoDescription ?? excerpt} image={image} article lang={lang}>
  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400">
      <a href={homeHref} class="hover:text-brand-700 dark:hover:text-brand-300">{t('nav.home')}</a>
      <span class="mx-1">/</span>
      <RegionBadge region={region} lang={lang} />
    </nav>

    <header class="mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">{title}</h1>
      <p class="mt-2 text-slate-500 dark:text-slate-400">
        {airport} ({iataCode}) — {city}, {country}
      </p>
      <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
        {t('article.published')} {formattedDate}
        {formattedUpdated && ` · ${t('article.updated')} ${formattedUpdated}`}
      </p>
    </header>

    <img src={image} alt={imageAlt} width={1200} height={630} loading="eager" decoding="async" class="mb-8 w-full rounded-xl object-cover" />

    {hubAirlines && hubAirlines.length > 0 && <HubAirlines airlines={hubAirlines} lang={lang} />}

    {quickFacts && (
      <QuickFacts
        iataCode={iataCode}
        passengers={quickFacts.passengers}
        terminals={quickFacts.terminals}
        distanceToCity={quickFacts.distanceToCity}
        lang={lang}
      />
    )}

    {spotlight && <AirportSpotlight title={spotlight.title} text={spotlight.text} lang={lang} />}

    <div class="grid gap-8 lg:grid-cols-[1fr_260px]">
      <div class="prose-article prose max-w-none dark:prose-invert">
        <AdSlot placement="article-top" />

        {transportOptions && transportOptions.length > 0 && (
          <>
            <h2 class="not-prose mb-1 text-lg font-bold text-slate-800 dark:text-slate-100">{t('article.gettingThere')}</h2>
            <TransportOptions items={transportOptions} />
          </>
        )}

        {security && arrivalGuidance && (
          <ArrivalTimeHelper
            typeALabel={security.typeALabel}
            typeATypical={security.typeATypical}
            typeAPeak={security.typeAPeak}
            typeAArrival={arrivalGuidance.typeA}
            typeBLabel={security.typeBLabel}
            typeBTypical={security.typeBTypical}
            typeBPeak={security.typeBPeak}
            typeBArrival={arrivalGuidance.typeB}
            lang={lang}
          />
        )}

        {amenities && amenities.length > 0 && (
          <>
            <h2 class="not-prose mb-1 text-lg font-bold text-slate-800 dark:text-slate-100">{t('article.amenitiesGlance')}</h2>
            <AmenityGrid items={amenities} />
          </>
        )}

        <slot />
        <AdSlot placement="article-bottom" />
      </div>
      <aside class="order-first lg:order-last">
        <div class="lg:sticky lg:top-20 lg:space-y-4">
          <TableOfContents headings={headings} lang={lang} />
          <AdSlot placement="sidebar" />
        </div>
      </aside>
    </div>

    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2 border-t border-slate-200 pt-6 dark:border-slate-800">
        {tags.map((tag) => (
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">#{tag}</span>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
